.header {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 24rpx;
  margin-bottom: 8rpx;
}

.source-badge {
  display: inline-block;
  font-size: 20rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  margin-bottom: 8rpx;
}
.source-badge.ok { background: #e7f6ef; color: #087f5b; }
.source-badge.warn { background: #fff4e5; color: #b45309; }

.control-row {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
  justify-content: flex-end;
}

.selector-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 24rpx 4rpx;
}
.selector-label { color: var(--muted); font-size: 22rpx; }
.plain-btn {
  color: var(--blue);
  font-size: 22rpx;
  margin-left: 20rpx;
}

.chips {
  white-space: nowrap;
  padding: 8rpx 24rpx 16rpx;
}
.chip {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 12rpx 16rpx;
  border: 1rpx solid var(--grid);
  border-radius: 8rpx;
  background: #fafbfc;
  margin-right: 12rpx;
  font-size: 20rpx;
}
.chip-on { background: #fff; font-weight: 600; }
.swatch { width: 16rpx; height: 16rpx; border-radius: 3rpx; flex: 0 0 auto; }
.chip-text { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 240rpx; }
.chip-code { font-weight: 700; margin-right: 8rpx; }

.chart-area { position: relative; padding: 10rpx 12rpx 16rpx; border-top: 1rpx solid var(--grid); }
.empty-hint {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--muted);
  font-size: 24rpx;
}

.index-tabs {
  white-space: nowrap;
  padding: 16rpx 24rpx;
  border-bottom: 1rpx solid var(--grid);
}
.index-tab {
  display: inline-block;
  padding: 12rpx 22rpx;
  border: 1rpx solid var(--border);
  border-radius: 8rpx;
  background: #fff;
  color: var(--muted);
  font-size: 22rpx;
  margin-right: 12rpx;
}
.index-tab.active { background: var(--ink); color: #fff; border-color: var(--ink); }

.index-kpis {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  border-bottom: 1rpx solid var(--grid);
}
.index-stat { padding: 16rpx 24rpx; border-right: 1rpx solid var(--grid); }
.index-stat:last-child { border-right: 0; }
.index-stat-label { display: block; color: var(--muted); font-size: 20rpx; }
.index-stat-value { display: block; font-size: 26rpx; font-weight: 700; margin-top: 6rpx; }
.index-stat-value.sm { font-size: 22rpx; }
.index-stat-sub { display: block; color: var(--muted); font-size: 18rpx; margin-top: 4rpx; }

.filter-band {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  margin: 28rpx 0 12rpx;
  flex-wrap: wrap;
}
.section-title { font-size: 32rpx; font-weight: 700; }
.group-filter { display: flex; flex-wrap: wrap; gap: 10rpx; }
.filter-btn {
  padding: 10rpx 20rpx;
  border: 1rpx solid var(--border);
  border-radius: 8rpx;
  background: #fff;
  color: var(--muted);
  font-size: 22rpx;
}
.filter-btn.active { background: var(--ink); color: #fff; border-color: var(--ink); }

.fund-cards {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}
.fund-card {
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: 12rpx;
  box-shadow: var(--shadow);
  overflow: hidden;
}
.fund-card-head {
  display: flex;
  justify-content: space-between;
  gap: 10rpx;
  padding: 18rpx 18rpx 8rpx;
}
.fund-id { min-width: 0; }
.fund-code { font-size: 26rpx; font-weight: 700; }
.fund-name { display: block; color: var(--muted); font-size: 20rpx; margin-top: 4rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.exchange-badge {
  flex: 0 0 auto;
  align-self: flex-start;
  padding: 4rpx 10rpx;
  border: 1rpx solid var(--border);
  border-radius: 6rpx;
  color: var(--muted);
  font-size: 18rpx;
}
.spark-wrap { height: 120rpx; padding: 4rpx 14rpx 0; }
.fund-card-stats { display: grid; grid-template-columns: 1fr 1fr; border-top: 1rpx solid var(--grid); }
.fund-card-stat { padding: 14rpx 18rpx; }
.fund-card-stat + .fund-card-stat { border-left: 1rpx solid var(--grid); }
.mini-label { display: block; color: var(--muted); font-size: 18rpx; }
.mini-value { display: block; font-size: 26rpx; font-weight: 700; margin-top: 4rpx; }
.coverage { padding: 12rpx 18rpx; border-top: 1rpx solid var(--grid); color: var(--muted); font-size: 18rpx; }

.sort-picker {
  font-size: 22rpx;
  color: var(--ink);
  border: 1rpx solid var(--border);
  border-radius: 8rpx;
  padding: 12rpx 20rpx;
  background: #fff;
}

.table-wrap { overflow-x: auto; }
.tr {
  display: flex;
  border-bottom: 1rpx solid var(--grid);
  font-size: 20rpx;
  white-space: nowrap;
}
.tr-head { background: #f5f7f8; color: var(--muted); font-weight: 600; }
.td {
  flex: 1 0 110rpx;
  padding: 16rpx 12rpx;
  text-align: right;
}
.td-l { flex: 1 0 150rpx; text-align: left; }
.table-code { font-weight: 700; }
.tr:active { background: #f8f9fa; }
