.detail-head {
  margin-bottom: 12rpx;
}
.notfound {
  text-align: center;
  color: var(--muted);
  font-size: 28rpx;
  padding: 80rpx 0;
}
.chart-area {
  padding: 10rpx 12rpx 16rpx;
  border-top: 1rpx solid var(--grid);
}
.control-row {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
  justify-content: flex-end;
}
.stat-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 20rpx;
}
.stat {
  padding: 20rpx 22rpx;
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: 12rpx;
  box-shadow: var(--shadow);
}
.stat-label { display: block; color: var(--muted); font-size: 22rpx; }
.stat-value { display: block; font-size: 34rpx; font-weight: 700; margin-top: 10rpx; }
.stat-sub { display: block; color: var(--muted); font-size: 18rpx; margin-top: 8rpx; }
