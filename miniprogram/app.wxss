page {
  --bg: #f3f5f7;
  --surface: #ffffff;
  --ink: #182026;
  --muted: #67727c;
  --border: #d8dee3;
  --grid: #e8ecef;
  --red: #b4232d;
  --green: #087f5b;
  --blue: #2563eb;
  --shadow: 0 2px 12px rgba(24, 32, 38, 0.07);
  background: var(--bg);
  color: var(--ink);
  font-family: "PingFang SC", "Microsoft YaHei", -apple-system, sans-serif;
  font-variant-numeric: tabular-nums;
}

view, text, scroll-view, button {
  box-sizing: border-box;
}

.page {
  padding: 20rpx 24rpx 60rpx;
}

.top-line {
  height: 8rpx;
  background: var(--red);
}

.eyebrow {
  color: var(--red);
  font-size: 22rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}
.h1 {
  font-size: 40rpx;
  font-weight: 700;
  margin: 0;
  line-height: 1.2;
}
.subtitle {
  color: var(--muted);
  font-size: 22rpx;
  margin-top: 10rpx;
}

.panel {
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: 12rpx;
  box-shadow: var(--shadow);
  margin: 20rpx 0;
  overflow: hidden;
}
.panel-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  padding: 22rpx 24rpx 16rpx;
  border-bottom: 1rpx solid var(--grid);
}
.panel-title {
  font-size: 30rpx;
  font-weight: 700;
}
.panel-note {
  color: var(--muted);
  font-size: 20rpx;
  margin-top: 6rpx;
}

.segmented {
  display: inline-flex;
  border: 1rpx solid var(--border);
  border-radius: 8rpx;
  overflow: hidden;
  background: #f7f8f9;
}
.segment {
  padding: 10rpx 18rpx;
  border: 0;
  border-right: 1rpx solid var(--border);
  background: transparent;
  color: var(--muted);
  font-size: 22rpx;
  line-height: 1.2;
}
.segment:last-child { border-right: 0; }
.segment.active {
  color: #fff;
  background: var(--red);
}

.kpis {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin: 20rpx 0;
}
.kpi {
  padding: 20rpx 22rpx;
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: 12rpx;
  box-shadow: var(--shadow);
}
.kpi-label { color: var(--muted); font-size: 22rpx; }
.kpi-value { font-size: 36rpx; font-weight: 700; margin-top: 10rpx; }
.kpi-meta { color: var(--muted); font-size: 20rpx; margin-top: 8rpx; }

.pos { color: var(--green); }
.neg { color: var(--red); }
.muted { color: var(--muted); }

.source-row {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}
.source-link {
  font-size: 20rpx;
  color: var(--blue);
  border: 1rpx solid var(--border);
  border-radius: 8rpx;
  padding: 8rpx 16rpx;
  background: #fff;
}

.footer {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  color: var(--muted);
  font-size: 20rpx;
  margin-top: 24rpx;
}
.source-note {
  border-left: 6rpx solid var(--red);
  background: #fff;
  color: var(--muted);
  font-size: 21rpx;
  line-height: 1.7;
  padding: 16rpx 18rpx;
  margin-top: 16rpx;
  border-radius: 0 8rpx 8rpx 0;
}
.source-note.szse { border-left-color: var(--blue); }
